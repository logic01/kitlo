# Local docker-compose secrets. Copy to .env and edit before `docker compose up`.
# .env itself is gitignored.

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=kitlo
POSTGRES_PORT=5432

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@kitlo.dev
PGADMIN_PASSWORD=change-me-locally
PGADMIN_PORT=5050

# ---- API (used only with `docker compose --profile full up -d`) ----
API_PORT=5268
API_ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=kitlo
JWT_AUDIENCE=kitlo-api
# Must be at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_KEY=replace-with-a-32-byte-or-longer-random-secret
